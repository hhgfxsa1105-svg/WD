      "checkConstraints": {
        "player_states_realm_valid": {
          "name": "player_states_realm_valid",
          "value": "\"player_states\".\"realm\" in ('body_tempering', 'opening', 'houtian', 'xiantian', 'grandmaster', 'mingshen', 'land_immortal')"
        },
        "player_states_progress_range": {
          "name": "player_states_progress_range",
          "value": "\"player_states\".\"realm_progress\" between 0 and 100"
        },
        "player_states_hp_range": {
          "name": "player_states_hp_range",
          "value": "\"player_states\".\"hp\" >= 0 and \"player_states\".\"max_hp\" >= 1 and \"player_states\".\"hp\" <= \"player_states\".\"max_hp\""
        },
        "player_states_stamina_range": {
          "name": "player_states_stamina_range",
          "value": "\"player_states\".\"stamina\" >= 0 and \"player_states\".\"max_stamina\" >= 1 and \"player_states\".\"stamina\" <= \"player_states\".\"max_stamina\""
        },
        "player_states_neili_consistent": {
          "name": "player_states_neili_consistent",
          "value": "(\"player_states\".\"neili_current\" is null and \"player_states\".\"neili_max\" is null) or (\"player_states\".\"neili_current\" is not null and \"player_states\".\"neili_max\" is not null and \"player_states\".\"neili_current\" >= 0 and \"player_states\".\"neili_max\" >= 1 and \"player_states\".\"neili_current\" <= \"player_states\".\"neili_max\")"
        },
        "player_states_currency_nonneg": {
          "name": "player_states_currency_nonneg",
          "value": "\"player_states\".\"yuanbao\" >= 0 and \"player_states\".\"silver\" >= 0 and \"player_states\".\"copper\" >= 0"
        },
        "player_states_version_nonneg": {
          "name": "player_states_version_nonneg",
          "value": "\"player_states\".\"version\" >= 0"
        },
        "player_states_cooldown_nonneg": {
          "name": "player_states_cooldown_nonneg",
          "value": "\"player_states\".\"breakthrough_available_at\" is null or \"player_states\".\"breakthrough_available_at\" >= 0"
        }
