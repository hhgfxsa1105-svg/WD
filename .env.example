# 复制为 .env 后按需修改；.env 不会被提交
HOST=127.0.0.1
PORT=3000
# SQLite 存档文件路径；相对路径以仓库根目录为准
DB_PATH=./data/jianghu.sqlite

# ---- AI（自由行动，S3）----
# 留空 = 关闭 AI，固定选项、挂机、存档等基础功能不受影响。
# openai-compatible = 任意兼容 /v1/chat/completions 的服务（国产模型厂商或中转站）
# mock = 本地关键词模拟，无需密钥，可先体验自由输入
AI_PROVIDER=
# 服务地址，写到 /v1 为止，例如 https://你的服务商或中转站地址/v1
AI_BASE_URL=
# 密钥只放在这里（本机后端读取），不要写进代码或提交到仓库
AI_API_KEY=
# 模型名，以你的服务商提供的为准
AI_MODEL=

# 以下为可选项，括号内是默认值
# AI_TIMEOUT_MS=20000        单次请求超时（毫秒）
# AI_MAX_RETRIES=2           超时、网络错误、限流、5xx 的最大重试次数
# AI_BACKOFF_MS=500          重试退避起点（毫秒，指数增长）
# AI_JSON_MODE=auto          auto 自动探测并降级｜on 强制｜off 关闭
# AI_MAX_OUTPUT_TOKENS=1000  单次输出 token 上限
# AI_MAX_INPUT_CHARS=6000    单次请求内容的字符数上限，超过则不发出
# AI_DAILY_CALL_LIMIT=200    每日调用次数上限（按本地日期，重启后依然有效）
# --- AI 叙事（结算之后才生成，失败不影响结果）---
# AI_NARRATE=important       off 不叙事 | important 只对突破 | all 修炼、休息也叙事
# AI_NARRATE_TIMEOUT_MS=8000 叙事等待上限，超时先返回模板叙事
# AI_NARRATE_DAILY_LIMIT=50  每日叙事调用上限（独立于总额度）
# AI_NARRATE_MAX_TOKENS=200  叙事输出 token 上限
