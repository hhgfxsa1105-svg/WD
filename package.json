{
  "name": "jianghu-zhi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "《江湖志》单机文字放置武侠游戏",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @jhz/server\" \"npm run dev -w @jhz/web\"",
    "build": "npm run build -w @jhz/web",
    "start": "npm run build && npm run start -w @jhz/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "db:generate": "npm run db:generate -w @jhz/server",
    "db:migrate": "npm run db:migrate -w @jhz/server",
    "db:export": "npm run db:export -w @jhz/server --",
    "db:import": "npm run db:import -w @jhz/server --"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "drizzle-orm": "^0.45.4",
    "typescript": "^5.7.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
